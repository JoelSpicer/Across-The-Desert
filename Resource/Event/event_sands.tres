[resource]
script = ExtResource("1_sands")
required_keywords = Array[String](["dunes"])
event_text = "A violent gust of wind suddenly whips the dunes into a blinding wall of abrasive sand. Visibility drops to zero in a matter of seconds."
choice_1_text = "Push blindly through the storm."
choice_2_text = "Hunker down and cover your equipment."
choice_1_gap_penalty = -10
choice_1_gives_affliction = "Clumsy"
choice_2_grit_cost = -2
choice_2_gives_affliction = "Slow"
