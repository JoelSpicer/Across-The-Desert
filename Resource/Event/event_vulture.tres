event_text = "A massive desert vulture picks at the remains of a traveler in the beating sun. A functioning revolver cylinder and some dried meat sit right beneath the bird's talons."
choice_1_text = "Shoot the bird to claim the loot."
choice_2_text = "Wrestle it away with your bare hands."
