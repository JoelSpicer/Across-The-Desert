[resource]
script = ExtResource("1_ntjdi")
required_keywords = Array[String](["scrubland"])
event_text = "A petrified tree juts from the dirt. A skeleton hangs from a frayed rope, and a glint of metal catches your eye in its pocket."
choice_1_text = "Climb up and search the body."
choice_2_text = "Shoot the rope to drop the body."
choice_1_grit_cost = 5
choice_1_item_reward = "Scrap"
choice_1_gives_affliction = "injured"
