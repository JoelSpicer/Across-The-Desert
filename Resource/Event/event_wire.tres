event_text = "A tangled mass of rusted razor wire blocks a narrow pass between two towering rock formations. It is the fastest route forward, but the rusted barbs are treacherous."
choice_1_text = "Force your way through the wire."
choice_2_text = "Take the long way around."
choice_1_grit_cost = -5
choice_1_gap_penalty = -15
choice_1_gives_affliction = "Bleeding"
