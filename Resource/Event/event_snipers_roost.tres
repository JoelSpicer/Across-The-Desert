event_text = "You spot a high ledge overlooking the canyon pass. It looks like an old sniper's nest. Scaling the cliff looks dangerous, but snipers usually leave brass behind."
choice_1_text = "Climb the jagged rocks."
choice_2_text = "Keep walking on the safe path."
