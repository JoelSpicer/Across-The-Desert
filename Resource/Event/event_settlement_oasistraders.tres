[gd_resource type="Resource" script_class="NarrativeEvent" format=3 uid="uid://settle3oasis"]

[ext_resource type="Script" uid="uid://tebrdjqw5ke" path="res://Scripts/NarrativeEvent.gd" id="1_oasis"]

[resource]
script = ExtResource("1_oasis")
required_keywords = Array[String](["scrubland"])
event_text = "You stumble upon a rare patch of hardy desert brush surrounding a murky watering hole. A group of heavily armed nomads have set up a small bazaar of tents near the water. They watch you carefully, but their weapons remain holstered."
choice_1_text = "Enter the Oasis bazaar."
choice_2_text = "Skirt around the camp."
choice_1_gap_penalty = 10
choice_1_opens_settlement = "Oasis Traders"
choice_2_grit_cost = -5
choice_2_gap_penalty = -10
metadata/_custom_type_script = "uid://tebrdjqw5ke"
