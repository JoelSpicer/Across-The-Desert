required_keywords = Array[String](["night", "bleeding"])
event_text = "The scent of your open wounds carries far on the cold breeze. A pack of starved desert hounds encircles you, their eyes reflecting the moonlight."
choice_1_text = "Fire into the dark to scatter them."
choice_2_text = "Run blindly into the night."
choice_1_ammo_cost = -3
choice_1_gun_condition_cost = -15
